# Copy to .env (gitignored) and fill in. Load with:  set -a; . ./.env; set +a

# --- The open web ----------------------------------------------------------
# Your own SearXNG, started by `docker compose up -d`. A dozen engines behind
# one keyless endpoint, and no rate limit because the instance is yours.
GROOVE_SEARXNG_URL=http://127.0.0.1:8888

# Pin which engines are used instead of all of them: a name, a comma-separated
# list ("searxng,duckduckgo"), or "none" to switch the open web off. Pinning
# one engine is the quickest way to tell its blind spot from a record nobody
# sells.
# GROOVE_SEARCH_PROVIDER=searxng

# Optional keyed engines. Either variable enables Brave; SERPER_API_KEY
# enables Serper. Neither is required - DuckDuckGo needs no account.
# GROOVE_SEARCH_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# --- Storage ---------------------------------------------------------------
# Where the registry and the page cache live (default: ./var).
# GROOVE_VAR=var

# --- Your streaming library ------------------------------------------------
# Read the last albums you added to Spotify or TIDAL and price the ones you
# tick. One app registration each, no client secret: the login is Authorization
# Code with PKCE. Register this exact redirect URI with the app —
#   http://127.0.0.1:8899/callback
# the 127.0.0.1 literal, not "localhost", which Spotify refuses to register.
# SPOTIFY_CLIENT_ID=
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=          # only if your TIDAL app type demands one

# The loopback port the consent page redirects back to, shared by the CLI and
# the web UI. Change it only if something else on this machine wants 8899 —
# the app's registered redirect URI has to match.
# GROOVE_OAUTH_PORT=8899
